# Tutory
LOGIN_URL=https://admin.tutory.com.br/login
LOGIN_USER=sua_conta
LOGIN_PASSWORD=sua_senha

# Onde salvar os PDFs
PASTA_DOWNLOAD=/home/luis-pimenta/Relatorios_Tutory

# Firefox (mesmo browser do teste manual)
# NÃO use /usr/bin/firefox se for wrapper do snap — o geckodriver rejeita.
# Use o binário real, por exemplo:
# FIREFOX_BINARY=/usr/lib/firefox/firefox
# FIREFOX_BINARY=/snap/firefox/current/usr/lib/firefox/firefox
# Perfil opcional:
# FIREFOX_PROFILE=/home/luis-pimenta/.mozilla/firefox/xxxx.default-release

# 1 = rodar sem janela
HEADLESS=0

# Timeouts (segundos)
TIMEOUT=25
DOWNLOAD_TIMEOUT=90
