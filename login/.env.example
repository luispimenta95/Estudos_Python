# URL da página de login
LOGIN_URL=https://exemplo.com/login

# Credenciais
LOGIN_USER=seu_usuario
LOGIN_PASSWORD=sua_senha

# Nomes dos campos do formulário (inspecione o HTML da página)
# Ex.: name="email" / name="password"
FIELD_USER=email
FIELD_PASSWORD=password

# URL opcional para validar se o login funcionou (área logada)
# Se vazia, o script só verifica o status da resposta do POST
CHECK_URL=

# Texto que deve aparecer na página após login (opcional)
SUCCESS_TEXT=

# Texto que indica falha de login (opcional)
FAILURE_TEXT=senha inválida
